{
    "name": "componenta/cqrs-transaction-cycle",
    "description": "Cycle Database transaction middleware for Componenta CQRS commands",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "componenta/config": "^1.0",
        "componenta/cqrs": "^1.0",
        "cycle/database": "^2.15"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\CQRS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\CQRS\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "extra": {
        "componenta": {
            "config-providers": [
                "Componenta\\CQRS\\Transaction\\Cycle\\ConfigProvider"
            ]
        }
    }
}
